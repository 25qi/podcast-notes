# 複製成 .env 後填入實際值。實際值本身存在 Bitwarden，.env 不進版控。

# --- 資料庫（AWS RDS Postgres）---
PN_DB_HOST=your-instance.xxxxxx.ap-northeast-1.rds.amazonaws.com
PN_DB_PORT=5432
PN_DB_NAME=podcast_notes
PN_DB_USER=podcast_notes_app
PN_DB_PASSWORD=
# 預設 require（必須加密）。本機 Docker Postgres 沒開 SSL 時才改成 disable
PN_DB_SSLMODE=require
# 連線逾時秒數
PN_DB_CONNECT_TIMEOUT=10

# --- Gemini ---
PN_GEMINI_API_KEY=
PN_GEMINI_MODEL=gemini-flash-latest

# --- Spotify 官方 Web API（developer.spotify.com/dashboard 建 app 取得）---
PN_SPOTIFY_CLIENT_ID=
PN_SPOTIFY_CLIENT_SECRET=
PN_SPOTIFY_MARKET=US

# --- AWS（開關 RDS 用）---
PN_AWS_REGION=ap-northeast-1
PN_RDS_INSTANCE_ID=podcast-notes-db

# --- 監控 ---
PN_HEALTHCHECK_PING_URL=

# --- 回填起點 ---
PN_BACKFILL_SINCE=2025-01-01
